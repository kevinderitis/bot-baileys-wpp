{
  "name": "arena-bot",
  "version": "1.0.0",
  "description": "Arena Bot - WhatsApp Bot with AI",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "clean": "rm -rf sessions",
    "migrate": "node scripts/migrate-session.mjs",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "electron:build:portable": "electron-builder --win portable"
  },
  "type": "module",
  "build": {
    "appId": "com.arenabot.app",
    "productName": "Arena Bot",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Arena Bot"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ]
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "groq-sdk": "^0.11.0",
    "jsonwebtoken": "^9.0.3",
    "libsignal-node": "github:whiskeysockets/libsignal-node",
    "mongoose": "^8.9.5",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^24.9.1"
  }
}
